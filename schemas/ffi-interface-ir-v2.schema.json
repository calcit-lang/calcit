{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calcit-lang.org/schemas/ffi-interface-ir-v2.schema.json",
  "title": "Calcit FFI Interface IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "package", "package_version", "declarations", "definitions"],
  "properties": {
    "version": { "const": 2 },
    "package": { "type": "string" },
    "package_version": { "type": "string" },
    "declarations": {
      "type": "array",
      "items": { "$ref": "#/$defs/declaration" }
    },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/definition" }
    }
  },
  "$defs": {
    "declaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "namespace", "name", "type_parameters", "fields"],
          "properties": {
            "kind": { "const": "struct" },
            "id": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type_parameters": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "type": { "$ref": "#/$defs/type" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "namespace", "name", "type_parameters", "variants"],
          "properties": {
            "kind": { "const": "enum" },
            "id": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type_parameters": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "payload"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "payload": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/type" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "name",
        "doc",
        "logical_schema",
        "signature",
        "lowering",
        "status",
        "diagnostic_codes"
      ],
      "properties": {
        "id": { "type": "string" },
        "namespace": { "type": "string" },
        "name": { "type": "string" },
        "doc": { "type": "string" },
        "logical_schema": { "type": "string" },
        "signature": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/functionSignature" }
          ]
        },
        "lowering": { "$ref": "#/$defs/lowering" },
        "status": { "enum": ["supported", "unsupported"] },
        "diagnostic_codes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "functionSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "result"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "type"],
            "properties": {
              "position": { "type": "integer", "minimum": 0 },
              "type": { "$ref": "#/$defs/type" }
            }
          }
        },
        "result": { "$ref": "#/$defs/type" }
      }
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["unit", "bool", "number", "string", "buffer"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item"],
          "properties": {
            "kind": { "enum": ["list", "option"] },
            "item": { "$ref": "#/$defs/type" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ok", "error"],
          "properties": {
            "kind": { "const": "result" },
            "ok": { "$ref": "#/$defs/type" },
            "error": { "$ref": "#/$defs/type" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "arguments"],
          "properties": {
            "kind": { "enum": ["struct", "enum"] },
            "id": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "array",
              "items": { "$ref": "#/$defs/type" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "type-parameter" },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "lowering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "target", "kind", "symbol", "invoke", "transport", "raw"],
      "properties": {
        "backend": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "symbol": { "type": ["string", "null"] },
        "invoke": { "type": ["string", "null"] },
        "transport": { "type": ["string", "null"] },
        "raw": { "type": "string" }
      }
    }
  }
}
