import { CalcitStructValue } from "./js-struct-value.mjs";
import { CalcitImpl } from "./js-impl.mjs";

/** Checks one enum payload against its declared type at `%::`. */
export type PayloadValidator = (value: unknown) => boolean;

export class CalcitEnumDef {
  prototype: CalcitStructValue;
  cachedHash: number;
  /** Per-variant payload validators generated by the compiler; null when nothing is checkable. */
  readonly payloadValidators: Record<string, (PayloadValidator | null)[]> | null;

  constructor(prototype: CalcitStructValue, payloadValidators: Record<string, (PayloadValidator | null)[]> | null = null) {
    this.prototype = prototype;
    this.cachedHash = null;
    this.payloadValidators = payloadValidators;
  }

  name(): string {
    return this.prototype.name.value;
  }

  get impls(): CalcitImpl[] {
    return this.prototype.structRef.impls;
  }

  withImpls(impls: CalcitImpl | CalcitImpl[]): CalcitEnumDef {
    let nextImpls: CalcitImpl[];
    if (impls instanceof CalcitImpl) {
      nextImpls = [impls];
    } else if (Array.isArray(impls)) {
      nextImpls = impls;
    } else {
      throw new Error("Expected an impl as implementation");
    }
    return new CalcitEnumDef(this.prototype.withImpls(nextImpls), this.payloadValidators);
  }

  toString(): string {
    return `(%enum-def '${this.prototype.name.value})`;
  }
}
